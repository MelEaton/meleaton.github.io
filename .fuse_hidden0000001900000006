        <!-- Page Header -->
        <header class="page-header">
            <div class="container page-header-content">
                <h1>Get in touch</h1>
                <p>Got a wall in mind? We'd love to hear about it.</p>
            </div>
        </header>

        <!-- Contact Section -->
        <section class="page-section" id="contact">
            <div class="container">
                <div class="row g-5">

                    <!-- Form -->
                    <div class="col-lg-8">
                        <!-- Enquiry Checklist -->
                        <div class="enquiry-checklist">
                            <h5>To get you an accurate estimate quickly, please include:</h5>
                            <ul>
                                <li>A photo of the wall or space</li>
                                <li>The dimensions (width &times; height in metres)</li>
                                <li>The location</li>
                            </ul>
                            <p class="mb-0 mt-2" style="font-size:0.85rem; color:#6c757d;">Design inspiration welcome — Pinterest boards, colour references, examples you like. Don't have any yet? No problem, we can guide that conversation.</p>
                        </div>

                        <!-- Contact Form -->
                        <!-- TODO: Wire up form to backend — Netlify Forms (add netlify attribute), Formspree, or similar -->
                        <form id="contactForm" action="https://formspree.io/f/mkoabonb" method="POST">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="name">Name <span class="text-primary">*</span></label>
                                    <input class="form-control" id="name" type="text" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="business">Business name <span class="text-muted" style="font-size:0.8rem;">(optional)</span></label>
                                    <input class="form-control" id="business" type="text" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="email">Email <span class="text-primary">*</span></label>
                                    <input class="form-control" id="email" type="email" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="phone">Phone <span class="text-primary">*</span></label>
                                    <input class="form-control" id="phone" type="tel" required />
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="location">Wall location <span class="text-primary">*</span></label>
                                    <input class="form-control" id="location" type="text" placeholder="e.g. Christchurch CBD, North Canterbury" required />
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="message">Tell us about your project <span class="text-primary">*</span></label>
                                    <textarea class="form-control" id="message" rows="5" placeholder="Include wall dimensions and any design inspiration if you have it." required></textarea>
                                </div>
                                <div class="col-12">
                                    <button class="btn btn-primary btn-xl text-uppercase" type="submit">Send enquiry</button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <!-- Contact Details -->
                    <div class="col-lg-4">
                        <p class="section-heading-sm">Direct contact</p>
                        <h3 class="h5 text-uppercase mb-4" style="font-family: var(--font-heading); font-weight:700; letter-spacing:0.1em;">Off The Wall Murals</h3>
                        <ul class="list-unstyled">
                            <li class="mb-3">
                                <i class="fas fa-envelope text-primary me-2"></i>
                                <a href="mailto:hello@offthewallmurals.nz">hello@offthewallmurals.nz</a>
                            </li>
                            <li class="mb-3">
                                <i class="fas fa-phone text-primary me-2"></i>
                                <a href="tel:+64211927774">021 192 7774</a>
                            </li>
                            <li class="mb-3">
                                <i class="fab fa-instagram text-primary me-2"></i>
                                <a href="https://www.instagram.com/offthewall.muralsnz/" target="_blank">@offthewall.muralsnz</a>
                            </li>
                        </ul>
                        <hr />
                        <p style="font-size:0.85rem; color:#6c757d;">Need brand or graphic design work? Visit <a href="https://meleaton.design" target="_blank">meleaton.design</a>.</p>
                    </div>

                </div>
            </div>
        </section>

